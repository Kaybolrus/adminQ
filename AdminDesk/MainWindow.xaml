<Window x:Class="AdminDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AdminDesk"
        Title="Admin Desk"
        Width="980" Height="640"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Компактная боковая навигация -->
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Левая панель: навигация ================= -->
        <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Admin Desk" FontSize="18" FontWeight="SemiBold"
                           Margin="18,16,12,12" Foreground="{StaticResource TextPrimaryBrush}"/>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" Tag="🖥" Content="Устройства"
                                 IsChecked="True" Click="NavDevices_Click"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="📁" Content="Полезные папки"
                                 Click="NavFolders_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Правая область ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель: заголовок раздела + поиск + кнопки действий -->
            <Grid Grid.Row="0" Margin="16,14,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SectionTitle" Grid.Column="0" Text="Устройства"
                           FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBox Grid.Column="1" x:Name="SearchBox" Width="260" HorizontalAlignment="Right"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         ToolTip="Поиск по имени и IP-адресу (для папок — по названию и пути)"/>

                <!-- Панель кнопок раздела «Устройства» -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0"
                            Visibility="{Binding IsDevicesView, Converter={StaticResource BoolToVis}}">
                    <Button Content="+ Добавить" Style="{StaticResource AccentButton}"
                            Command="{Binding AddDeviceCommand}"/>
                    <Button Content="Изменить" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                            Command="{Binding EditDeviceCommand}"/>
                    <Button Content="Удалить" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                            Command="{Binding DeleteDeviceCommand}"/>
                </StackPanel>

                <!-- Панель кнопок раздела «Папки» -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0"
                            Visibility="{Binding IsDevicesView, Converter={StaticResource InvertBool}, ConverterParameter=True}">
                    <Button Content="+ Добавить" Style="{StaticResource AccentButton}"
                            Command="{Binding AddFolderCommand}"/>
                    <Button Content="Изменить" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                            Command="{Binding EditFolderCommand}"/>
                    <Button Content="Удалить" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                            Command="{Binding DeleteFolderCommand}"/>
                </StackPanel>
            </Grid>

            <!-- ================= Список устройств (карточки) ================= -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,4"
                          Visibility="{Binding IsDevicesView, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding VisibleDevices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DeviceCardStyle}"
                                    MouseLeftButtonUp="DeviceCard_Click"
                                    Cursor="Hand" ToolTip="{Binding Description}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Address}" FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <!-- Индикатор статуса -->
                                        <Ellipse Grid.Column="1" Width="12" Height="12" VerticalAlignment="Top"
                                                 Fill="{Binding StatusBrushKey, Converter={StaticResource StringToBrush}}"
                                                 ToolTip="{Binding StatusDisplay}" Margin="0,4,0,0"/>
                                    </Grid>

                                    <TextBlock Margin="0,6,0,0" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding TypeDisplay, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding StatusDisplay, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding LastCheckDisplay, Mode=OneWay}"/>
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <!-- Кнопка RDP показывается только если для устройства разрешён RDP -->
                                        <Button Content="🖫 RDP" Style="{StaticResource FlatButton}"
                                                Padding="8,3" FontSize="12"
                                                Visibility="{Binding RdpAllowed, Converter={StaticResource BoolToVis}}"
                                                Click="RdpButton_Click" Tag="{Binding}"
                                                ToolTip="Подключиться через mstsc.exe"/>
                                        <Button Content="✎" Style="{StaticResource FlatButton}" Padding="8,3"
                                                FontSize="12" Margin="6,0,0,0"
                                                Click="EditDeviceButton_Click" Tag="{Binding}"
                                                ToolTip="Редактировать"/>
                                        <Button Content="🗑" Style="{StaticResource FlatButton}" Padding="8,3"
                                                FontSize="12" Margin="6,0,0,0"
                                                Click="DeleteDeviceButton_Click" Tag="{Binding}"
                                                ToolTip="Удалить"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ================= Список папок (карточки) ================= -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,4"
                          Visibility="{Binding IsDevicesView, Converter={StaticResource InvertBool}, ConverterParameter=True}">
                <ItemsControl ItemsSource="{Binding VisibleFolders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Нажатие на карточку открывает папку в Проводнике -->
                            <Border Style="{StaticResource FolderCardStyle}"
                                    MouseLeftButtonUp="FolderCard_Click"
                                    Cursor="Hand" ToolTip="Открыть: {Binding Path}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="20" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Path}" FontSize="12" Margin="0,4,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="↑" Style="{StaticResource FlatButton}" Padding="8,3"
                                                FontSize="12" Click="MoveUp_Click" Tag="{Binding}"
                                                ToolTip="Выше в списке"/>
                                        <Button Content="↓" Style="{StaticResource FlatButton}" Padding="8,3"
                                                FontSize="12" Margin="6,0,0,0" Click="MoveDown_Click" Tag="{Binding}"
                                                ToolTip="Ниже в списке"/>
                                        <Button Content="✎" Style="{StaticResource FlatButton}" Padding="8,3"
                                                FontSize="12" Margin="6,0,0,0"
                                                Click="EditFolderButton_Click" Tag="{Binding}"
                                                ToolTip="Редактировать"/>
                                        <Button Content="🗑" Style="{StaticResource FlatButton}" Padding="8,3"
                                                FontSize="12" Margin="6,0,0,0"
                                                Click="DeleteFolderButton_Click" Tag="{Binding}"
                                                ToolTip="Удалить запись"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
