<Window x:Class="AdminDesk.Views.FolderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Папка" Width="480" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource ContentBackgroundBrush}">

    <StackPanel Margin="20,16">
        <TextBlock x:Name="TitleText" Text="Новая папка" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Название *" VerticalAlignment="Center" Margin="0,6"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,6"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Путь *" VerticalAlignment="Center" Margin="0,6"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6"
                     Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Описание" VerticalAlignment="Top" Margin="0,6"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6" Height="40" TextWrapping="Wrap"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Тип (иконка)" VerticalAlignment="Center" Margin="0,6"/>
            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,6" x:Name="IconCombo"/>
        </Grid>

        <TextBlock Text="Примеры путей: C:\Tools или \\DS2\FS-1\install" FontSize="11"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource StatusOfflineBrush}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource FlatButton}" IsCancel="True" MinWidth="90"
                    Click="Cancel_Click"/>
            <Button Content="Сохранить" Style="{StaticResource AccentButton}" MinWidth="100" Margin="8,0,0,0"
                    IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
