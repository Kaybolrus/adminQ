<Window x:Class="AdminDesk.Views.DeviceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AdminDesk.Models"
        Title="Устройство" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource ContentBackgroundBrush}">

    <StackPanel Margin="20,16">
        <TextBlock x:Name="TitleText" Text="Новое устройство" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя *" VerticalAlignment="Center" Margin="0,6"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,6" x:Name="NameBox"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="IP-адрес или DNS-имя *" VerticalAlignment="Center" Margin="0,6"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6" x:Name="AddressBox"
                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Тип устройства" VerticalAlignment="Center" Margin="0,6"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,6" x:Name="TypeCombo"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Описание" VerticalAlignment="Top" Margin="0,6"/>
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6" Height="48" TextWrapping="Wrap"
                     AcceptsReturn="False" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

            <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,8" Content="Проверять доступность"
                      IsChecked="{Binding MonitorEnabled}"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Способ проверки" VerticalAlignment="Center" Margin="0,6"/>
            <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,6" x:Name="MethodCombo"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="TCP-порт (для TCP-проверки)" VerticalAlignment="Center" Margin="0,6"/>
            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,6" MaxLength="5" x:Name="PortBox"
                     Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <CheckBox Margin="0,10,0,0" Content="Разрешить запуск RDP (кнопка «Подключить»)"
                  IsChecked="{Binding RdpAllowed}"/>

        <!-- Сообщение об ошибке валидации -->
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource StatusOfflineBrush}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource FlatButton}" IsCancel="True" MinWidth="90"
                    Click="Cancel_Click"/>
            <Button Content="Сохранить" Style="{StaticResource AccentButton}" MinWidth="100" Margin="8,0,0,0"
                    IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
