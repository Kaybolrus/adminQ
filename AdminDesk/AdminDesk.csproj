<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>Admin Desk</AssemblyTitle>
    <Product>Admin Desk</Product>
    <Version>1.0.0</Version>
    <!-- Приложение не требует прав администратора -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF собирается только на Windows. Отдельный проект AdminDesk.Core.csproj
         (чистый net8.0) позволяет проверить компиляцию моделей и сервисов на Linux/macOS. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Не тянуть файлы служебного проекта Core в основной -->
    <Compile Remove="obj_core/**" />
    <None Remove="obj_core/**" />
  </ItemGroup>

</Project>
